rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorizedErpUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "manager", "viewer"];
    }

    function canWriteErpData() {
      return isAuthorizedErpUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "manager"];
    }

    function isAdmin() {
      return isAuthorizedErpUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isFieldUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["supervisor", "engineer"];
    }

    function canReadDailyProgressReport() {
      // Field users only see their own operational updates. Core ERP roles keep
      // their existing access to all DPR documents, including legacy records.
      return isAuthorizedErpUser() ||
        (isFieldUser() && resource.data.createdBy == request.auth.uid);
    }

    function isValidDprUsageValue(value) {
      // Current forms submit text. Phase 3 legacy/structured DPRs can contain
      // a list of material or equipment entries, so both are accepted.
      return (value is string && value.size() <= 1000) ||
        (value is list && value.size() <= 25);
    }

    function hasValidOptionalDprUsageFields() {
      return (!request.resource.data.keys().hasAll(["materialsUsed"]) ||
          isValidDprUsageValue(request.resource.data.materialsUsed)) &&
        (!request.resource.data.keys().hasAll(["equipmentUsed"]) ||
          isValidDprUsageValue(request.resource.data.equipmentUsed));
    }

    function hasValidFieldDailyProgressReport() {
      return request.resource.data.keys().hasAll([
          "site",
          "date",
          "workActivity",
          "workLocation",
          "quantity",
          "unit",
          "manpowerCount",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]) &&
        // Field users may create only the operational DPR schema emitted by
        // Field Update/offline sync. This prevents arbitrary fields or nested
        // data from being smuggled into a manager-visible ERP document.
        request.resource.data.keys().hasOnly([
          "date",
          "site",
          "workActivity",
          "workLocation",
          "quantity",
          "unit",
          "manpowerCount",
          "materialsUsed",
          "equipmentUsed",
          "remarks",
          "materialQuantity",
          "equipmentUsage",
          "createdBy",
          "clientSubmissionId",
          "photos",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.site is string && request.resource.data.site.size() > 0 &&
        request.resource.data.site.size() <= 200 &&
        request.resource.data.date is string &&
          request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.workActivity is string && request.resource.data.workActivity.size() > 0 &&
          request.resource.data.workActivity.size() <= 500 &&
        request.resource.data.workLocation is string && request.resource.data.workLocation.size() > 0 &&
          request.resource.data.workLocation.size() <= 500 &&
        request.resource.data.unit is string && request.resource.data.unit.size() > 0 &&
          request.resource.data.unit.size() <= 50 &&
        request.resource.data.quantity is number && request.resource.data.quantity >= 0 &&
        request.resource.data.manpowerCount is number && request.resource.data.manpowerCount >= 0 &&
        hasValidOptionalDprUsageFields() &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (!request.resource.data.keys().hasAll(["materialQuantity"]) ||
          (request.resource.data.materialQuantity is number && request.resource.data.materialQuantity >= 0)) &&
        (!request.resource.data.keys().hasAll(["equipmentUsage"]) ||
          (request.resource.data.equipmentUsage is number && request.resource.data.equipmentUsage >= 0)) &&
        (!request.resource.data.keys().hasAll(["remarks"]) ||
          (request.resource.data.remarks is string && request.resource.data.remarks.size() <= 2000)) &&
        (!request.resource.data.keys().hasAll(["clientSubmissionId"]) ||
          (request.resource.data.clientSubmissionId is string &&
            request.resource.data.clientSubmissionId.size() > 0 &&
            request.resource.data.clientSubmissionId.size() <= 200)) &&
        (!request.resource.data.keys().hasAll(["photos"]) ||
          (request.resource.data.photos is list && request.resource.data.photos.size() <= 5));
    }

    function canCreateFieldDailyProgressReport() {
      return isFieldUser() &&
        request.resource.data.createdBy == request.auth.uid &&
        hasValidFieldDailyProgressReport();
    }

    // New equipment masters keep a verified owner and safe operational values.
    // Existing legacy vehicle documents remain readable and editable by their
    // existing manager/admin policy.
    function hasValidVehicleMasterData() {
      return request.resource.data.keys().hasAll([
          "vehicleNumber", "vehicleType", "site", "fuel", "status",
          "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.vehicleNumber is string && request.resource.data.vehicleNumber.size() > 0 &&
        request.resource.data.vehicleType is string && request.resource.data.vehicleType.size() > 0 &&
        request.resource.data.site is string && request.resource.data.site.size() > 0 &&
        request.resource.data.fuel is number && request.resource.data.fuel >= 0 &&
        request.resource.data.status in ["Active", "Idle", "Under Maintenance", "Breakdown", "Off Hire"] &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    }

    // vehicleExpenses is the sole financial source for new fuel and
    // maintenance entries. Fuel totals are checked from quantity × rate so a
    // client cannot submit a forged amount. Legacy records are unaffected.
    function hasValidVehicleExpenseData() {
      return request.resource.data.keys().hasAll([
          "vehicleId", "vehicleNumber", "vehicleName", "site", "date",
          "expenseType", "amount", "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.vehicleId is string && request.resource.data.vehicleId.size() > 0 &&
        request.resource.data.vehicleNumber is string && request.resource.data.vehicleNumber.size() > 0 &&
        request.resource.data.vehicleName is string && request.resource.data.vehicleName.size() > 0 &&
        request.resource.data.site is string && request.resource.data.site.size() > 0 &&
        request.resource.data.date is string && request.resource.data.date.size() > 0 &&
        request.resource.data.expenseType in ["Fuel", "Maintenance", "Repair", "Driver Payment", "Toll", "Insurance", "Other"] &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        (!request.resource.data.keys().hasAll(["totalAmount"]) ||
          (request.resource.data.totalAmount is number && request.resource.data.totalAmount == request.resource.data.amount)) &&
        (!request.resource.data.keys().hasAll(["meterReading"]) ||
          (request.resource.data.meterReading is number && request.resource.data.meterReading >= 0)) &&
        (request.resource.data.expenseType != "Fuel" ||
          (request.resource.data.keys().hasAll(["fuelType", "quantity", "ratePerLitre"]) &&
            request.resource.data.fuelType in ["Diesel", "Petrol", "CNG", "Electric", "Other"] &&
            request.resource.data.quantity is number && request.resource.data.quantity > 0 &&
            request.resource.data.ratePerLitre is number && request.resource.data.ratePerLitre > 0 &&
            request.resource.data.amount == request.resource.data.quantity * request.resource.data.ratePerLitre &&
            (!request.resource.data.keys().hasAll(["fuelQuantity"]) ||
              (request.resource.data.fuelQuantity is number && request.resource.data.fuelQuantity == request.resource.data.quantity)))) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    }
    function hasValidAuditLogData() {
      return request.resource.data.keys().hasAll([
          "userId",
          "userEmail",
          "userRole",
          "action",
          "module",
          "recordId",
          "timestamp",
          "details",
          "site"
        ]) &&
        request.resource.data.keys().hasOnly([
          "userId",
          "userEmail",
          "userRole",
          "action",
          "module",
          "recordId",
          "recordLabel",
          "timestamp",
          "details",
          "site"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userEmail is string && request.resource.data.userEmail.size() <= 320 &&
        request.resource.data.userRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role &&
        request.resource.data.userRole in ["admin", "manager", "supervisor", "engineer"] &&
        request.resource.data.action in ["create", "update", "delete"] &&
        request.resource.data.module in [
          "labour",
          "sites",
          "materials",
          "expenses",
          "attendance",
          "salary",
          "salaryPayments",
          "labourAdvances",
          "vehicle",
          "vehicleExpenses",
          "vehicleAssignments",
          "vehicleMaintenance",
          "invoices",
          "dailyProgressReports",
          "inventoryItems",
          "inventoryTransactions",
          "vendors",
          "purchaseRequests",
          "purchaseOrders",
          "goodsReceipts",
          "workOrders",
          "workOrderProgress",
          "contractorBills",
          "contractorPayments",
          "clients",
          "siteBillingProfiles",
          "raBills",
          "clientReceipts",
          "raRetentionReleases",
          "boqItems",
          "boqMeasurements",
          "boqVariations"
        ] &&
        request.resource.data.recordId is string &&
          request.resource.data.recordId.size() > 0 && request.resource.data.recordId.size() <= 200 &&
        (!request.resource.data.keys().hasAll(["recordLabel"]) ||
          (request.resource.data.recordLabel is string && request.resource.data.recordLabel.size() <= 250)) &&
        request.resource.data.details is string && request.resource.data.details.size() <= 1000 &&
        request.resource.data.site is string && request.resource.data.site.size() <= 200 &&
        request.resource.data.timestamp == request.time;
    }

    function canCreateAuditLog() {
      return hasValidAuditLogData() &&
        (canWriteErpData() ||
          (isFieldUser() &&
            request.resource.data.module == "dailyProgressReports" &&
            request.resource.data.action == "create"));
    }

    // System-health events are technical diagnostics, not business audit records.
    // They contain only a strict, sanitised enum payload and are immutable.
    function isMonitoringReporter() {
      return isAuthorizedErpUser() || isFieldUser();
    }

    function hasValidSystemHealthEventData() {
      return request.resource.data.keys().hasAll([
          "userId",
          "userRole",
          "category",
          "severity",
          "code",
          "module",
          "operation",
          "timestamp"
        ]) &&
        request.resource.data.keys().hasOnly([
          "userId",
          "userRole",
          "category",
          "severity",
          "code",
          "module",
          "operation",
          "timestamp"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role &&
        request.resource.data.userRole in ["admin", "manager", "viewer", "supervisor", "engineer"] &&
        request.resource.data.category in [
          "NETWORK",
          "AUTHENTICATION",
          "PERMISSION",
          "VALIDATION",
          "FIRESTORE_READ",
          "FIRESTORE_WRITE",
          "EXPORT",
          "APPLICATION",
          "UNKNOWN"
        ] &&
        request.resource.data.severity in ["INFO", "WARNING", "ERROR", "CRITICAL"] &&
        request.resource.data.code in [
          "permission-denied",
          "unauthenticated",
          "unavailable",
          "deadline-exceeded",
          "failed-precondition",
          "resource-exhausted",
          "aborted",
          "cancelled",
          "not-found",
          "invalid-argument",
          "auth-network-request-failed",
          "auth-user-disabled",
          "auth-user-token-expired",
          "auth-invalid-credential",
          "auth-too-many-requests",
          "auth-requires-recent-login",
          "auth-operation-not-allowed",
          "application-crash",
          "unknown"
        ] &&
        request.resource.data.module in [
          "app",
          "auth",
          "notifications",
          "exports",
          "fieldUpdate",
          "dailyProgressReports",
          "expenses",
          "inventory",
          "purchaseOrders",
          "goodsReceipts",
          "attendance",
          "payroll",
          "salary",
          "clientBilling",
          "payments",
          "boq",
          "vehicles",
          "reports",
          "backup",
          "procurement",
          "subcontracting",
          "audit",
          "unknown"
        ] &&
        request.resource.data.operation in [
          "read",
          "write",
          "authentication",
          "export",
          "application",
          "sync",
          "unknown"
        ] &&
        request.resource.data.timestamp == request.time;
    }

    function canCreateSystemHealthEvent() {
      return isMonitoringReporter() && hasValidSystemHealthEventData();
    }


    // RA bills are operational until certification writes exactly one linked
    // invoice. The existing invoices ledger remains canonical for revenue.
    function hasValidClientFields() {
      return request.resource.data.keys().hasAll(["clientName", "contactPerson", "mobile", "email", "gstin", "panNumber", "billingAddress", "notes", "status", "createdBy", "createdAt", "updatedAt"]) &&
        request.resource.data.keys().hasOnly(["clientName", "contactPerson", "mobile", "email", "gstin", "panNumber", "billingAddress", "notes", "status", "createdBy", "createdAt", "updatedAt"]) &&
        request.resource.data.clientName is string && request.resource.data.clientName.size() > 0 && request.resource.data.clientName.size() <= 200 &&
        request.resource.data.contactPerson is string && request.resource.data.contactPerson.size() <= 200 &&
        request.resource.data.mobile is string && request.resource.data.mobile.size() <= 20 &&
        (request.resource.data.mobile.size() == 0 || request.resource.data.mobile.matches('^[0-9]{10}$')) &&
        request.resource.data.email is string && request.resource.data.email.size() <= 320 &&
        request.resource.data.gstin is string && request.resource.data.gstin.size() <= 30 && request.resource.data.panNumber is string && request.resource.data.panNumber.size() <= 30 &&
        request.resource.data.billingAddress is string && request.resource.data.billingAddress.size() <= 1000 && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000 && request.resource.data.status in ["active", "inactive"];
    }

    function hasValidBillingProfileFields() {
      return request.resource.data.keys().hasAll(["siteId", "siteName", "clientId", "clientName", "agreementNumber", "contractValue", "startDate", "completionDate", "billingType", "gstApplicable", "gstRate", "retentionPercent", "securityDeposit", "advanceReceived", "paymentTerms", "remarks", "advanceAdjusted", "certifiedWorkValue", "lastCertifiedBillId", "createdBy", "createdAt", "updatedAt"]) &&
        request.resource.data.keys().hasOnly(["siteId", "siteName", "clientId", "clientName", "agreementNumber", "contractValue", "startDate", "completionDate", "billingType", "gstApplicable", "gstRate", "retentionPercent", "securityDeposit", "advanceReceived", "paymentTerms", "remarks", "advanceAdjusted", "certifiedWorkValue", "lastCertifiedBillId", "createdBy", "createdAt", "updatedAt"]) &&
        request.resource.data.siteId is string && request.resource.data.siteId.size() > 0 && request.resource.data.siteName is string && request.resource.data.siteName.size() > 0 && request.resource.data.siteName.size() <= 200 &&
        request.resource.data.clientId is string && request.resource.data.clientId.size() > 0 && request.resource.data.clientName is string && request.resource.data.clientName.size() > 0 && request.resource.data.clientName.size() <= 200 &&
        request.resource.data.agreementNumber is string && request.resource.data.agreementNumber.size() > 0 && request.resource.data.agreementNumber.size() <= 200 &&
        request.resource.data.startDate is string && request.resource.data.startDate.size() > 0 && request.resource.data.completionDate is string && request.resource.data.completionDate.size() > 0 &&
        request.resource.data.billingType in ["Running Account", "Milestone", "Lump Sum", "Other"] && request.resource.data.gstApplicable is bool &&
        request.resource.data.contractValue is number && request.resource.data.contractValue > 0 && request.resource.data.gstRate is number && request.resource.data.gstRate >= 0 && request.resource.data.gstRate <= 100 &&
        request.resource.data.retentionPercent is number && request.resource.data.retentionPercent >= 0 && request.resource.data.retentionPercent <= 100 && request.resource.data.securityDeposit is number && request.resource.data.securityDeposit >= 0 &&
        request.resource.data.advanceReceived is number && request.resource.data.advanceReceived >= 0 && request.resource.data.advanceAdjusted is number && request.resource.data.advanceAdjusted >= 0 && request.resource.data.advanceAdjusted <= request.resource.data.advanceReceived &&
        request.resource.data.certifiedWorkValue is number && request.resource.data.certifiedWorkValue >= 0 && request.resource.data.certifiedWorkValue <= request.resource.data.contractValue &&
        request.resource.data.lastCertifiedBillId is string && request.resource.data.lastCertifiedBillId.size() <= 200 && request.resource.data.paymentTerms is string && request.resource.data.paymentTerms.size() <= 1000 && request.resource.data.remarks is string && request.resource.data.remarks.size() <= 1000;
    }

    function hasValidOptionalBoqBillingLines() {
      // Line details are validation snapshots only. RA bill and invoice values
      // remain the existing canonical income source. Firestore Rules cannot
      // iterate every list map, so shape/quantity validation is performed by
      // the shared client helper; writes remain manager/admin-only.
      return !request.resource.data.keys().hasAll(["boqLineItems"]) ||
        (request.resource.data.boqLineItems is list && request.resource.data.boqLineItems.size() <= 50);
    }
    function hasValidRABillFields() {
      return request.resource.data.keys().hasAll(["raBillNumber", "siteId", "site", "clientId", "clientName", "agreementNumber", "billingPeriodFrom", "billingPeriodTo", "billDate", "paymentDueDate", "previousCertifiedAmount", "cumulativeCertifiedAmount", "currentWorkValue", "variationAmount", "grossWorkValue", "materialAdvanceRecovery", "advanceAdjustment", "otherDeductions", "recoveries", "retentionPercent", "retentionAmount", "tdsPercent", "tdsAmount", "gstRate", "gstAmount", "netBillAmount", "status", "receivedAmount", "pendingAmount", "retentionReleased", "retentionBalance", "linkedInvoiceId", "lastReceiptId", "lastRetentionReleaseId", "remarks", "createdBy", "createdAt", "updatedAt"]) &&
        request.resource.data.keys().hasOnly(["raBillNumber", "siteId", "site", "clientId", "clientName", "agreementNumber", "billingPeriodFrom", "billingPeriodTo", "billDate", "paymentDueDate", "previousCertifiedAmount", "cumulativeCertifiedAmount", "currentWorkValue", "variationAmount", "grossWorkValue", "materialAdvanceRecovery", "advanceAdjustment", "otherDeductions", "recoveries", "retentionPercent", "retentionAmount", "tdsPercent", "tdsAmount", "gstRate", "gstAmount", "netBillAmount", "status", "receivedAmount", "pendingAmount", "retentionReleased", "retentionBalance", "linkedInvoiceId", "lastReceiptId", "lastRetentionReleaseId", "remarks", "boqLineItems", "certifiedAt", "createdBy", "createdAt", "updatedAt"]) &&
        request.resource.data.raBillNumber is string && request.resource.data.raBillNumber.size() > 0 && request.resource.data.raBillNumber.size() <= 100 && request.resource.data.siteId is string && request.resource.data.siteId.size() > 0 && request.resource.data.site is string && request.resource.data.site.size() > 0 && request.resource.data.site.size() <= 200 &&
        request.resource.data.clientId is string && request.resource.data.clientId.size() > 0 && request.resource.data.clientName is string && request.resource.data.clientName.size() > 0 && request.resource.data.clientName.size() <= 200 && request.resource.data.agreementNumber is string && request.resource.data.agreementNumber.size() > 0 && request.resource.data.agreementNumber.size() <= 200 &&
        request.resource.data.billingPeriodFrom is string && request.resource.data.billingPeriodFrom.size() > 0 && request.resource.data.billingPeriodTo is string && request.resource.data.billingPeriodTo.size() > 0 && request.resource.data.billDate is string && request.resource.data.billDate.size() > 0 && request.resource.data.paymentDueDate is string && request.resource.data.paymentDueDate.size() > 0 &&
        request.resource.data.status in ["Draft", "Submitted", "Certified", "Partially Paid", "Paid", "Rejected", "Cancelled"] &&
        request.resource.data.previousCertifiedAmount is number && request.resource.data.previousCertifiedAmount >= 0 && request.resource.data.cumulativeCertifiedAmount is number && request.resource.data.cumulativeCertifiedAmount >= request.resource.data.previousCertifiedAmount &&
        request.resource.data.currentWorkValue is number && request.resource.data.currentWorkValue > 0 && request.resource.data.variationAmount is number && request.resource.data.variationAmount >= 0 && request.resource.data.grossWorkValue is number && request.resource.data.grossWorkValue >= request.resource.data.currentWorkValue &&
        request.resource.data.materialAdvanceRecovery is number && request.resource.data.materialAdvanceRecovery >= 0 && request.resource.data.advanceAdjustment is number && request.resource.data.advanceAdjustment >= 0 && request.resource.data.otherDeductions is number && request.resource.data.otherDeductions >= 0 && request.resource.data.recoveries is number && request.resource.data.recoveries >= 0 &&
        request.resource.data.retentionPercent is number && request.resource.data.retentionPercent >= 0 && request.resource.data.retentionPercent <= 100 && request.resource.data.retentionAmount is number && request.resource.data.retentionAmount >= 0 && request.resource.data.tdsPercent is number && request.resource.data.tdsPercent >= 0 && request.resource.data.tdsPercent <= 100 && request.resource.data.tdsAmount is number && request.resource.data.tdsAmount >= 0 && request.resource.data.gstRate is number && request.resource.data.gstRate >= 0 && request.resource.data.gstRate <= 100 && request.resource.data.gstAmount is number && request.resource.data.gstAmount >= 0 &&
        request.resource.data.netBillAmount is number && request.resource.data.netBillAmount >= 0 && request.resource.data.receivedAmount is number && request.resource.data.receivedAmount >= 0 && request.resource.data.receivedAmount <= request.resource.data.netBillAmount && request.resource.data.pendingAmount is number && request.resource.data.pendingAmount >= 0 && request.resource.data.retentionReleased is number && request.resource.data.retentionReleased >= 0 && request.resource.data.retentionReleased <= request.resource.data.retentionAmount && request.resource.data.retentionBalance is number && request.resource.data.retentionBalance >= 0 &&
        hasValidOptionalBoqBillingLines() &&
        request.resource.data.linkedInvoiceId is string && request.resource.data.linkedInvoiceId.size() <= 200 && request.resource.data.lastReceiptId is string && request.resource.data.lastReceiptId.size() <= 250 && request.resource.data.lastRetentionReleaseId is string && request.resource.data.lastRetentionReleaseId.size() <= 250 && request.resource.data.remarks is string && request.resource.data.remarks.size() <= 1000;
    }

    function hasValidRABillTransition() {
      return request.resource.data.status == resource.data.status ||
        (resource.data.status == "Draft" && request.resource.data.status in ["Submitted", "Cancelled"]) ||
        (resource.data.status == "Submitted" && request.resource.data.status in ["Certified", "Rejected", "Cancelled"]) ||
        (resource.data.status == "Certified" && request.resource.data.status in ["Partially Paid", "Paid"]) ||
        (resource.data.status == "Partially Paid" && request.resource.data.status == "Paid");
    }

    function preservesSubmittedRABillFields() {
      return resource.data.status == "Draft" ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "linkedInvoiceId", "certifiedAt", "receivedAmount", "pendingAmount",
          "retentionReleased", "retentionBalance", "lastReceiptId", "lastRetentionReleaseId", "updatedAt"
        ]);
    }
    function hasValidClientReceiptData(receiptId) {
      let billPath = /databases/$(database)/documents/raBills/$(request.resource.data.raBillId);
