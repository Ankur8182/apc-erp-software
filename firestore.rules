        request.resource.data.quantity is number && request.resource.data.quantity > 0 && request.resource.data.dimensions is map &&
        hasValidBoqMeasurementDimensions() &&
        request.resource.data.remarks is string && request.resource.data.remarks.size() <= 1000 && request.resource.data.dprId is string && request.resource.data.dprId.size() <= 200 &&
        request.resource.data.status in ["Pending", "Certified", "Rejected"] && request.resource.data.measuredBy == request.resource.data.createdBy &&
        request.resource.data.createdBy is string && request.resource.data.createdBy.size() > 0;
    }

    function hasValidBoqMeasurementTransition() {
      return resource.data.status == "Pending" && request.resource.data.status in ["Certified", "Rejected"] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "certifiedBy", "certifiedAt", "updatedAt"]) &&
        request.resource.data.certifiedBy == request.auth.uid && request.resource.data.certifiedAt == request.time;
    }

    function hasValidBoqVariationData() {
      let itemPath = /databases/$(database)/documents/boqItems/$(request.resource.data.boqItemId);
      return request.resource.data.keys().hasAll([
          "siteId", "site", "boqItemId", "variationReference", "itemNumber", "itemCode", "description", "unit",
          "quantityChange", "revisedRate", "variationValue", "reason", "status", "createdBy", "createdAt", "updatedAt"
        ]) && request.resource.data.keys().hasOnly([
          "siteId", "site", "boqItemId", "variationReference", "itemNumber", "itemCode", "description", "unit",
          "quantityChange", "revisedRate", "variationValue", "reason", "status", "createdBy", "createdAt", "updatedAt", "approvedBy", "approvedAt"
        ]) && request.resource.data.siteId is string && request.resource.data.siteId.size() > 0 && request.resource.data.site is string && request.resource.data.site.size() > 0 &&
        request.resource.data.boqItemId is string && request.resource.data.variationReference is string && request.resource.data.variationReference.size() > 0 && request.resource.data.variationReference.size() <= 120 &&
        request.resource.data.itemNumber is string && request.resource.data.itemNumber.size() <= 100 && request.resource.data.itemCode is string && request.resource.data.itemCode.size() <= 100 &&
        request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 1000 &&
        request.resource.data.unit in ["Nos", "Sqm", "Cum", "Rmt", "Kg", "MT", "Litre", "Job", "LS"] &&
        request.resource.data.quantityChange is number && request.resource.data.quantityChange != 0 && request.resource.data.revisedRate is number && request.resource.data.revisedRate >= 0 &&
        request.resource.data.variationValue is number && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 1000 &&
        request.resource.data.status in ["Draft", "Submitted", "Approved", "Rejected"] && request.resource.data.createdBy is string && request.resource.data.createdBy.size() > 0 &&
        (request.resource.data.boqItemId == "" || (exists(itemPath) && request.resource.data.siteId == get(itemPath).data.siteId && request.resource.data.site == get(itemPath).data.site && request.resource.data.itemNumber == get(itemPath).data.itemNumber && request.resource.data.unit == get(itemPath).data.unit));
    }

    function hasValidBoqVariationTransition() {
      return ((resource.data.status == "Draft" && request.resource.data.status == "Submitted") ||
          (resource.data.status == "Submitted" && request.resource.data.status in ["Approved", "Rejected"])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "approvedBy", "approvedAt", "updatedAt"]) &&
        (request.resource.data.status == "Submitted" || (request.resource.data.approvedBy == request.auth.uid && request.resource.data.approvedAt == request.time));
    }
    // Users may read only their own authorization profile. Roles can only be
    // assigned or changed from the Firebase Console/Admin SDK, never by a client.
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Root-only master records. The client has no supported site subcollection;
    // avoiding a recursive match keeps future nested paths default-denied.
    match /sites/{siteId} {
      allow read: if isAuthorizedErpUser() || isFieldUser();
      allow create, update, delete: if canWriteErpData();
    }

    // Budget documents are separated from site reference records so field
    // users can select a site for DPR entry without receiving finance data.
    match /siteBudgets/{siteId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidSiteBudgetData(siteId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidSiteBudgetData(siteId) &&
        request.resource.data.siteId == resource.data.siteId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Quantity-only availability documents are safe for field users to read.
    // Supplier references and stock data intentionally exclude rates/costs.
    match /inventoryItems/{itemId} {
      allow read: if isAuthorizedErpUser() || isFieldUser();
      allow create: if canWriteErpData() && hasValidInventoryItemData(itemId) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidInventoryItemData(itemId) &&
        request.resource.data.itemKey == resource.data.itemKey &&
        request.resource.data.materialName == resource.data.materialName &&
        request.resource.data.site == resource.data.site &&
        request.resource.data.unit == resource.data.unit &&
        request.resource.data.openingStock == resource.data.openingStock &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        ((request.resource.data.currentStock == resource.data.currentStock &&
            sameInventoryLastTransactionId()) ||
          isInventoryItemMovementUpdate(itemId));
      allow delete: if false;
    }

    // Stock movements are append-only. The inventory item stores a safe
    // current-stock snapshot for field availability, while this ledger remains
    // available only to core ERP roles.
    match /inventoryTransactions/{transactionId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidInventoryTransactionData() &&
        request.resource.data.createdAt == request.time &&
        isInventoryTransactionApplied(transactionId) &&
        (!request.resource.data.keys().hasAll(["sourceType"]) ||
          request.resource.data.sourceType != "goodsReceipt" ||
          isLinkedGoodsReceiptMovement(transactionId));
      allow update, delete: if false;
    }

    // Procurement master data is append-preserved: vendors can be disabled,
    // but not deleted once they may be referenced by purchasing history.
    match /vendors/{vendorId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidVendorData() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidVendorData() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /purchaseRequests/{requestId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidPurchaseRequestData(requestId) &&
        request.resource.data.status == "pending approval" &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidPurchaseRequestData(requestId) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time &&
        hasValidPurchaseRequestTransition();
      allow delete: if false;
    }

    match /purchaseOrders/{orderId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidPurchaseOrderData(orderId) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidPurchaseOrderData(orderId) &&
        request.resource.data.poNumber == resource.data.poNumber &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time &&
        hasValidPurchaseOrderTransition();
      allow delete: if false;
    }

    // GRNs are completed once. Any accepted quantity is linked atomically to
    // one immutable inventory Stock-In movement and one materials cost record.
    match /goodsReceipts/{receiptId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidGoodsReceiptData(receiptId) &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time &&
        isGoodsReceiptLinkedToPurchaseOrder(receiptId) &&
        (request.resource.data.acceptedQuantity == 0 || hasLinkedGoodsReceiptRecords(receiptId));
      allow update, delete: if false;
    }

    // Subcontracting ledgers use the shared vendor master. Draft commercial
    // terms can be corrected; approved contracts and bill history are retained.
    match /workOrders/{orderId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidWorkOrderData(orderId) &&
        request.resource.data.status == "Draft" && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidWorkOrderData(orderId) &&
        request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time && hasValidWorkOrderTransition() &&
        (resource.data.status == "Draft" || hasImmutableWorkOrderCommercialFields());
      allow delete: if false;
    }

    // Progress certification is append-only and never creates an accounting cost.
    match /workOrderProgress/{progressId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidWorkOrderProgressData() &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    // A contractor bill can only be created together with its one linked
    // expenses record. This makes that expenses record the canonical cost source.
    match /contractorBills/{billId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidContractorBillData(billId) &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time &&
        request.resource.data.paidAmount == 0 && request.resource.data.pendingAmount == request.resource.data.payableAmount &&
        request.resource.data.retentionReleased == 0 && request.resource.data.retentionBalance == request.resource.data.retentionAmount &&
        hasLinkedContractorExpense(billId) && hasValidContractorBillAgainstWorkOrder();
      allow update: if canWriteErpData() && hasValidContractorBillData(billId) &&
        request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "paidAmount", "pendingAmount", "retentionReleased", "retentionBalance", "paymentStatus", "updatedAt"
        ]) &&
        request.resource.data.paidAmount >= resource.data.paidAmount && request.resource.data.paidAmount <= request.resource.data.payableAmount &&
        request.resource.data.pendingAmount == request.resource.data.payableAmount - request.resource.data.paidAmount &&
        request.resource.data.retentionReleased >= resource.data.retentionReleased && request.resource.data.retentionReleased <= request.resource.data.retentionAmount &&
        request.resource.data.retentionBalance == request.resource.data.retentionAmount - request.resource.data.retentionReleased;
      allow delete: if false;
    }

    // Payment entries settle an existing bill but never create a second expense.
    match /contractorPayments/{paymentId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidContractorPaymentData() &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }
    match /labours/{labourId} {
      allow read: if isAuthorizedErpUser();
      allow create, update, delete: if canWriteErpData();
    }

    match /materials/{materialId} {
      // Material purchases can contain rates and amounts. Field users receive
      // names/availability through inventoryItems instead of this collection.
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() &&
        (!request.resource.data.keys().hasAll(["source"]) ||
          request.resource.data.source != "procurement" ||
          isLinkedProcurementMaterial(materialId));
      // Procurement GRN cost entries are immutable links to the accepted
      // receipt. They remain the single financial source for that purchase.
      allow update, delete: if canWriteErpData() &&
        (!resource.data.keys().hasAll(["source"]) || resource.data.source != "procurement");
    }

    match /expenses/{expenseId} {
      allow read: if isAuthorizedErpUser();
      allow create, update, delete: if canWriteErpData();
    }

    match /attendance/{attendanceId} {
      allow read: if isAuthorizedErpUser();
      allow create, update, delete: if canWriteErpData();
    }

    match /salaries/{salaryId} {
      allow read: if isAuthorizedErpUser();
      allow create, update, delete: if canWriteErpData();
    }

    function isLinkedSalaryPayment() {
      let salaryPath = /databases/$(database)/documents/salaries/$(request.resource.data.salaryId);
      let beforeSalary = get(salaryPath).data;
      let afterSalary = getAfter(salaryPath).data;
      return exists(salaryPath) &&
        beforeSalary.pendingAmount is number && beforeSalary.paidAmount is number &&
        request.resource.data.amount <= beforeSalary.pendingAmount &&
        afterSalary.paidAmount == beforeSalary.paidAmount + request.resource.data.amount &&
        afterSalary.pendingAmount == beforeSalary.pendingAmount - request.resource.data.amount;
    }

    // Payroll payments are an immutable settlement ledger. They do not add a
    // second financial expense: the linked salary's net amount is canonical.
    match /salaryPayments/{paymentId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() &&
        request.resource.data.keys().hasAll([
          "salaryId", "labourId", "labourName", "payrollMonth", "site",
          "amount", "paymentDate", "paymentMode", "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.salaryId is string && request.resource.data.salaryId.size() > 0 &&
        request.resource.data.labourId is string && request.resource.data.labourId.size() > 0 &&
        request.resource.data.labourName is string && request.resource.data.labourName.size() > 0 &&
        request.resource.data.payrollMonth is string && request.resource.data.payrollMonth.size() == 7 &&
        request.resource.data.site is string && request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.paymentDate is string && request.resource.data.paymentDate.size() > 0 &&
        request.resource.data.paymentMode is string && request.resource.data.paymentMode.size() > 0 &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time &&
        isLinkedSalaryPayment();
      allow update, delete: if false;
    }

    // Advances retain their original issue record. Only manager/admin recovery
    // state may change; field roles receive no read access to payroll data.
    match /labourAdvances/{advanceId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() &&
        request.resource.data.keys().hasAll([
          "labourId", "labourName", "site", "date", "amount", "recoveredAmount",
          "recoveryStatus", "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.labourId is string && request.resource.data.labourId.size() > 0 &&
        request.resource.data.labourName is string && request.resource.data.labourName.size() > 0 &&
        request.resource.data.site is string && request.resource.data.date is string && request.resource.data.date.size() > 0 &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.recoveredAmount is number && request.resource.data.recoveredAmount >= 0 &&
        request.resource.data.recoveredAmount <= request.resource.data.amount &&
        request.resource.data.recoveryStatus in ["Pending", "Partial", "Recovered"] &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.labourId == resource.data.labourId &&
        request.resource.data.recoveredAmount is number && request.resource.data.recoveredAmount >= resource.data.recoveredAmount &&
        request.resource.data.recoveredAmount <= resource.data.amount &&
        request.resource.data.recoveryStatus in ["Pending", "Partial", "Recovered"] &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isAuthorizedErpUser() || isFieldUser();
      allow create: if canWriteErpData() && hasValidVehicleMasterData();
      allow update, delete: if canWriteErpData();
    }

    match /vehicleExpenses/{vehicleExpenseId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidVehicleExpenseData();
      // Retain existing manager/admin edit/delete behavior for legacy expense
      // documents that predate the normalized ledger fields.
      allow update, delete: if canWriteErpData();
    }

    // Assignment movements retain a release trail. A manager can close the
    // current assignment but cannot rewrite where/when it was assigned.
    match /vehicleAssignments/{assignmentId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() &&
        request.resource.data.keys().hasAll([
          "vehicleId", "vehicleNumber", "site", "assignmentDate", "releaseDate",
          "assignmentStatus", "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.vehicleId is string && request.resource.data.vehicleId.size() > 0 &&
        request.resource.data.vehicleNumber is string && request.resource.data.site is string && request.resource.data.site.size() > 0 &&
        request.resource.data.assignmentDate is string && request.resource.data.assignmentDate.size() > 0 &&
        request.resource.data.releaseDate is string && request.resource.data.assignmentStatus == "Assigned" &&
        request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() &&
        request.resource.data.vehicleId == resource.data.vehicleId &&
        request.resource.data.vehicleNumber == resource.data.vehicleNumber &&
        request.resource.data.site == resource.data.site &&
        request.resource.data.assignmentDate == resource.data.assignmentDate &&
        request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.releaseDate is string && request.resource.data.releaseDate.size() > 0 &&
        request.resource.data.assignmentStatus == "Released" && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Maintenance records are append-only operational history. Its optional
    // linked vehicleExpenses document is the single financial cost source.
    match /vehicleMaintenance/{maintenanceId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() &&
        request.resource.data.keys().hasAll([
          "vehicleId", "vehicleNumber", "site", "maintenanceType", "serviceDate",
          "labourCost", "partsCost", "otherCost", "totalCost", "status", "linkedExpenseId",
          "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.vehicleId is string && request.resource.data.vehicleId.size() > 0 &&
        request.resource.data.vehicleNumber is string && request.resource.data.site is string && request.resource.data.site.size() > 0 &&
        request.resource.data.maintenanceType is string && request.resource.data.maintenanceType.size() > 0 &&
        request.resource.data.serviceDate is string && request.resource.data.serviceDate.size() > 0 &&
        request.resource.data.labourCost is number && request.resource.data.labourCost >= 0 &&
        request.resource.data.partsCost is number && request.resource.data.partsCost >= 0 &&
        request.resource.data.otherCost is number && request.resource.data.otherCost >= 0 &&
        request.resource.data.totalCost is number && request.resource.data.totalCost >= 0 &&
        request.resource.data.totalCost == request.resource.data.labourCost + request.resource.data.partsCost + request.resource.data.otherCost &&
        request.resource.data.status in ["Open", "In Progress", "Completed"] &&
        request.resource.data.linkedExpenseId is string && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    // Root-only DPR records. In particular, a field user must never obtain
    // create access to an arbitrary nested path under somebody else's DPR.
    match /dailyProgressReports/{reportId} {
      allow read: if canReadDailyProgressReport();
      allow create: if canWriteErpData() || canCreateFieldDailyProgressReport();
      allow update, delete: if canWriteErpData();
    }

    // BOQ rates and commercial quantities are limited to standard ERP roles.
    // Field-only users receive neither the BOQ master nor its billing/value data.
    match /boqItems/{itemId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidBoqItemData() && request.resource.data.status == "Draft" &&
        request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidBoqItemData() && hasValidBoqItemTransition() &&
        request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time &&
        (resource.data.status == "Draft" || hasImmutableActiveBoqCommercialFields());
      allow delete: if false;
    }

    match /boqMeasurements/{measurementId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidBoqMeasurementData() && request.resource.data.status == "Pending" &&
        !request.resource.data.keys().hasAll(["certifiedBy"]) && !request.resource.data.keys().hasAll(["certifiedAt"]) && request.resource.data.createdBy == request.auth.uid && request.resource.data.measuredBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidBoqMeasurementData() && hasValidBoqMeasurementTransition() &&
        request.resource.data.createdBy == resource.data.createdBy && request.resource.data.measuredBy == resource.data.measuredBy &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /boqVariations/{variationId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidBoqVariationData() && request.resource.data.status == "Draft" &&
        !request.resource.data.keys().hasAll(["approvedBy"]) && !request.resource.data.keys().hasAll(["approvedAt"]) && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidBoqVariationData() && hasValidBoqVariationTransition() &&
        request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Audit entries are immutable. The client can append an identity-validated
    // entry after a successful action, but only an active administrator can read it.
    match /auditLogs/{documentId} {
      allow read: if isAdmin();
      allow create: if canCreateAuditLog();
      allow update, delete: if false;
    }

    // Sanitised operational failures are visible only to administrators.
    // Clients may only append their own strict enum-shaped event; no client can
    // resolve, edit, delete, or read global monitoring history.
    match /systemHealthEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if canCreateSystemHealthEvent();
      allow update, delete: if false;
    }


    match /clients/{clientId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidClientFields() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidClientFields() && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /siteBillingProfiles/{siteId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && request.resource.data.siteId == siteId && hasValidBillingProfileFields() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && request.resource.data.siteId == siteId && hasValidBillingProfileFields() && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /raBills/{billId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && request.resource.data.raBillNumber == billId && request.resource.data.status == "Draft" && hasValidRABillFields() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidRABillFields() && hasValidRABillTransition() && preservesSubmittedRABillFields() && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /clientReceipts/{receiptId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidClientReceiptData(receiptId) && receiptMatchesAtomicUpdates(receiptId);
      allow update, delete: if false;
    }

    match /raRetentionReleases/{releaseId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidRetentionReleaseData() && retentionReleaseMatchesAtomicUpdate(releaseId);
      allow update, delete: if false;
    }
    match /invoices/{invoiceId} {
      allow read: if isAuthorizedErpUser();
      allow create, update, delete: if canWriteErpData();
    }

    // Any current or future collection not explicitly listed is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
