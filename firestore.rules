rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorizedErpUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "manager", "viewer"];
    }

    function canWriteErpData() {
      return isAuthorizedErpUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "manager"];
    }

    function isAdmin() {
      return isAuthorizedErpUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isFieldUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["supervisor", "engineer"];
    }

    function canReadDailyProgressReport() {
      // Field users only see their own operational updates. Core ERP roles keep
      // their existing access to all DPR documents, including legacy records.
      return isAuthorizedErpUser() ||
        (isFieldUser() && resource.data.createdBy == request.auth.uid);
    }

    function isValidDprUsageValue(value) {
      // Current forms submit text. Phase 3 legacy/structured DPRs can contain
      // a list of material or equipment entries, so both are accepted.
      return value is string || (value is list && value.size() <= 25);
    }

    function hasValidOptionalDprUsageFields() {
      return (!request.resource.data.keys().hasAll(["materialsUsed"]) ||
          isValidDprUsageValue(request.resource.data.materialsUsed)) &&
        (!request.resource.data.keys().hasAll(["equipmentUsed"]) ||
          isValidDprUsageValue(request.resource.data.equipmentUsed));
    }

    function hasValidFieldDailyProgressReport() {
      return request.resource.data.keys().hasAll([
          "site",
          "date",
          "workActivity",
          "workLocation",
          "quantity",
          "unit",
          "manpowerCount",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.site is string && request.resource.data.site.size() > 0 &&
        request.resource.data.date is string && request.resource.data.date.size() > 0 &&
        request.resource.data.workActivity is string && request.resource.data.workActivity.size() > 0 &&
        request.resource.data.workLocation is string && request.resource.data.workLocation.size() > 0 &&
        request.resource.data.unit is string && request.resource.data.unit.size() > 0 &&
        request.resource.data.quantity is number && request.resource.data.quantity >= 0 &&
        request.resource.data.manpowerCount is number && request.resource.data.manpowerCount >= 0 &&
        hasValidOptionalDprUsageFields() &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (!request.resource.data.keys().hasAll(["materialQuantity"]) ||
          (request.resource.data.materialQuantity is number && request.resource.data.materialQuantity >= 0)) &&
        (!request.resource.data.keys().hasAll(["equipmentUsage"]) ||
          (request.resource.data.equipmentUsage is number && request.resource.data.equipmentUsage >= 0)) &&
        (!request.resource.data.keys().hasAll(["photos"]) ||
          (request.resource.data.photos is list && request.resource.data.photos.size() <= 5));
    }

    function canCreateFieldDailyProgressReport() {
      return isFieldUser() &&
        request.resource.data.createdBy == request.auth.uid &&
        hasValidFieldDailyProgressReport();
    }

    function hasValidAuditLogData() {
      return request.resource.data.keys().hasAll([
          "userId",
          "userEmail",
          "userRole",
          "action",
          "module",
          "recordId",
          "timestamp",
          "details",
          "site"
        ]) &&
        request.resource.data.keys().hasOnly([
          "userId",
          "userEmail",
          "userRole",
          "action",
          "module",
          "recordId",
          "recordLabel",
          "timestamp",
          "details",
          "site"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userEmail is string && request.resource.data.userEmail.size() <= 320 &&
        request.resource.data.userRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role &&
        request.resource.data.userRole in ["admin", "manager", "supervisor", "engineer"] &&
        request.resource.data.action in ["create", "update", "delete"] &&
        request.resource.data.module in [
          "labour",
          "sites",
          "materials",
          "expenses",
          "attendance",
          "salary",
          "salaryPayments",
          "labourAdvances",
          "vehicle",
          "vehicleExpenses",
          "invoices",
          "dailyProgressReports",
          "inventoryItems",
          "inventoryTransactions",
          "vendors",
          "purchaseRequests",
          "purchaseOrders",
          "goodsReceipts"
        ] &&
        request.resource.data.recordId is string &&
          request.resource.data.recordId.size() > 0 && request.resource.data.recordId.size() <= 200 &&
        (!request.resource.data.keys().hasAll(["recordLabel"]) ||
          (request.resource.data.recordLabel is string && request.resource.data.recordLabel.size() <= 250)) &&
        request.resource.data.details is string && request.resource.data.details.size() <= 1000 &&
        request.resource.data.site is string && request.resource.data.site.size() <= 200 &&
        request.resource.data.timestamp == request.time;
    }

    function canCreateAuditLog() {
      return hasValidAuditLogData() &&
        (canWriteErpData() ||
          (isFieldUser() &&
            request.resource.data.module == "dailyProgressReports" &&
            request.resource.data.action == "create"));
    }

    function hasValidSiteBudgetData(siteId) {
      return request.resource.data.keys().hasAll(["siteId", "siteName", "budget"]) &&
        request.resource.data.keys().hasOnly([
          "siteId",
          "siteName",
          "budget",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.siteId == siteId &&
        request.resource.data.siteName is string &&
        request.resource.data.siteName.size() > 0 &&
        request.resource.data.siteName.size() <= 200 &&
        request.resource.data.budget is map &&
        request.resource.data.budget.keys().hasOnly([
          "totalProjectBudget",
          "materialBudget",
          "labourBudget",
          "vehicleBudget",
          "otherExpenseBudget",
          "contingencyBudget"
        ]) &&
        (!request.resource.data.budget.keys().hasAll(["totalProjectBudget"]) ||
          (request.resource.data.budget.totalProjectBudget is number &&
            request.resource.data.budget.totalProjectBudget >= 0)) &&
        (!request.resource.data.budget.keys().hasAll(["materialBudget"]) ||
          (request.resource.data.budget.materialBudget is number &&
            request.resource.data.budget.materialBudget >= 0)) &&
        (!request.resource.data.budget.keys().hasAll(["labourBudget"]) ||
          (request.resource.data.budget.labourBudget is number &&
            request.resource.data.budget.labourBudget >= 0)) &&
        (!request.resource.data.budget.keys().hasAll(["vehicleBudget"]) ||
          (request.resource.data.budget.vehicleBudget is number &&
            request.resource.data.budget.vehicleBudget >= 0)) &&
        (!request.resource.data.budget.keys().hasAll(["otherExpenseBudget"]) ||
          (request.resource.data.budget.otherExpenseBudget is number &&
            request.resource.data.budget.otherExpenseBudget >= 0)) &&
        (!request.resource.data.budget.keys().hasAll(["contingencyBudget"]) ||
          (request.resource.data.budget.contingencyBudget is number &&
            request.resource.data.budget.contingencyBudget >= 0));
    }

    function hasValidInventoryItemData(itemId) {
      return request.resource.data.keys().hasAll([
          "itemKey",
          "materialName",
          "site",
          "unit",
          "openingStock",
          "reorderLevel",
          "currentStock",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "itemKey",
          "materialName",
          "site",
          "unit",
          "openingStock",
          "reorderLevel",
          "currentStock",
          "supplier",
          "reference",
          "notes",
          "lastTransactionId",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.itemKey == itemId &&
        request.resource.data.materialName is string && request.resource.data.materialName.size() > 0 && request.resource.data.materialName.size() <= 200 &&
        request.resource.data.site is string && request.resource.data.site.size() > 0 && request.resource.data.site.size() <= 200 &&
        request.resource.data.unit is string && request.resource.data.unit.size() > 0 && request.resource.data.unit.size() <= 50 &&
        request.resource.data.openingStock is number && request.resource.data.openingStock >= 0 &&
        request.resource.data.reorderLevel is number && request.resource.data.reorderLevel >= 0 &&
        request.resource.data.currentStock is number && request.resource.data.currentStock >= 0 &&
        request.resource.data.createdBy is string && request.resource.data.createdBy.size() > 0 && request.resource.data.createdBy.size() <= 128 &&
        (!request.resource.data.keys().hasAll(["supplier"]) ||
          (request.resource.data.supplier is string && request.resource.data.supplier.size() <= 250)) &&
        (!request.resource.data.keys().hasAll(["reference"]) ||
          (request.resource.data.reference is string && request.resource.data.reference.size() <= 250)) &&
        (!request.resource.data.keys().hasAll(["notes"]) ||
          (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000)) &&
        (!request.resource.data.keys().hasAll(["lastTransactionId"]) ||
          (request.resource.data.lastTransactionId is string && request.resource.data.lastTransactionId.size() > 0 && request.resource.data.lastTransactionId.size() <= 200));
    }

    function hasValidInventoryTransactionData() {
      return request.resource.data.keys().hasAll([
          "inventoryItemId",
          "materialName",
          "site",
          "unit",
          "transactionType",
          "quantity",
          "date",
          "createdBy",
          "createdAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "inventoryItemId",
          "materialName",
          "site",
          "unit",
          "transactionType",
          "adjustmentDirection",
          "quantity",
          "date",
          "reason",
          "reference",
          "notes",
          "sourceType",
          "goodsReceiptId",
          "purchaseOrderId",
          "vendorId",
          "siteId",
          "materialId",
          "createdBy",
          "createdAt"
        ]) &&
        request.resource.data.inventoryItemId is string && request.resource.data.inventoryItemId.size() > 0 &&
        request.resource.data.materialName is string && request.resource.data.materialName.size() > 0 && request.resource.data.materialName.size() <= 200 &&
        request.resource.data.site is string && request.resource.data.site.size() > 0 && request.resource.data.site.size() <= 200 &&
        request.resource.data.unit is string && request.resource.data.unit.size() > 0 && request.resource.data.unit.size() <= 50 &&
        request.resource.data.transactionType in ["in", "out", "adjustment"] &&
        request.resource.data.quantity is number && request.resource.data.quantity > 0 &&
        request.resource.data.date is string && request.resource.data.date.size() >= 10 && request.resource.data.date.size() <= 30 &&
        request.resource.data.createdBy == request.auth.uid &&
        (!request.resource.data.keys().hasAll(["adjustmentDirection"]) ||
          request.resource.data.adjustmentDirection in ["increase", "decrease"]) &&
        (request.resource.data.transactionType != "adjustment" ||
          (request.resource.data.keys().hasAll(["adjustmentDirection", "reason"]) &&
            request.resource.data.reason is string && request.resource.data.reason.size() > 0)) &&
        (!request.resource.data.keys().hasAll(["reason"]) ||
          (request.resource.data.reason is string && request.resource.data.reason.size() <= 500)) &&
        (!request.resource.data.keys().hasAll(["reference"]) ||
          (request.resource.data.reference is string && request.resource.data.reference.size() <= 250)) &&
        (!request.resource.data.keys().hasAll(["notes"]) ||
          (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000)) &&
        (!request.resource.data.keys().hasAll(["sourceType"]) ||
          (request.resource.data.sourceType is string && request.resource.data.sourceType.size() <= 50)) &&
        (!request.resource.data.keys().hasAll(["goodsReceiptId"]) ||
          (request.resource.data.goodsReceiptId is string && request.resource.data.goodsReceiptId.size() <= 200)) &&
        (!request.resource.data.keys().hasAll(["purchaseOrderId"]) ||
          (request.resource.data.purchaseOrderId is string && request.resource.data.purchaseOrderId.size() <= 200)) &&
        (!request.resource.data.keys().hasAll(["vendorId"]) ||
          (request.resource.data.vendorId is string && request.resource.data.vendorId.size() <= 200)) &&
        (!request.resource.data.keys().hasAll(["siteId"]) ||
          (request.resource.data.siteId is string && request.resource.data.siteId.size() <= 200)) &&
        (!request.resource.data.keys().hasAll(["materialId"]) ||
          (request.resource.data.materialId is string && request.resource.data.materialId.size() <= 200));
    }

    function isLinkedGoodsReceiptMovement(transactionId) {
      let receiptPath = /databases/$(database)/documents/goodsReceipts/$(request.resource.data.goodsReceiptId);
      let receipt = getAfter(receiptPath).data;
      let materialPath = /databases/$(database)/documents/materials/$(receipt.materialEntryId);
      let material = getAfter(materialPath).data;

      return request.resource.data.keys().hasAll(["goodsReceiptId", "purchaseOrderId", "vendorId"]) &&
          existsAfter(receiptPath) &&
          existsAfter(materialPath) &&
          receipt.inventoryTransactionId == transactionId &&
          receipt.purchaseOrderId == request.resource.data.purchaseOrderId &&
          receipt.vendorId == request.resource.data.vendorId &&
          receipt.materialName == request.resource.data.materialName &&
          receipt.site == request.resource.data.site &&
          material.goodsReceiptId == request.resource.data.goodsReceiptId &&
          material.purchaseOrderId == request.resource.data.purchaseOrderId &&
          material.inventoryTransactionId == transactionId;
    }

    function hasValidVendorData() {
      return request.resource.data.keys().hasAll([
          "vendorName", "openingBalance", "status", "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "vendorName", "contactPerson", "mobile", "email", "gstNumber", "panNumber",
          "address", "city", "state", "category", "openingBalance", "notes", "status",
          "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.vendorName is string && request.resource.data.vendorName.size() > 0 && request.resource.data.vendorName.size() <= 250 &&
        request.resource.data.openingBalance is number && request.resource.data.openingBalance >= 0 &&
        request.resource.data.status in ["active", "inactive"] &&
        request.resource.data.createdBy is string && request.resource.data.createdBy.size() > 0 && request.resource.data.createdBy.size() <= 128 &&
        (!request.resource.data.keys().hasAll(["mobile"]) ||
          (request.resource.data.mobile is string && request.resource.data.mobile.size() <= 20)) &&
        (!request.resource.data.keys().hasAll(["email"]) ||
          (request.resource.data.email is string && request.resource.data.email.size() <= 320)) &&
        (!request.resource.data.keys().hasAll(["notes"]) ||
          (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));
    }

    function hasValidPurchaseRequestData(requestId) {
      return request.resource.data.keys().hasAll([
          "requestNumber", "date", "site", "requestedBy", "requiredDate", "priority",
          "items", "status", "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "requestNumber", "date", "site", "requestedBy", "requiredDate", "priority",
          "purpose", "notes", "items", "status", "approvedBy", "approvedAt",
          "rejectionReason", "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.requestNumber == requestId &&
        request.resource.data.date is string && request.resource.data.date.size() >= 10 &&
        request.resource.data.site is string && request.resource.data.site.size() > 0 && request.resource.data.site.size() <= 200 &&
        request.resource.data.requestedBy is string && request.resource.data.requestedBy.size() > 0 && request.resource.data.requestedBy.size() <= 250 &&
        request.resource.data.requiredDate is string && request.resource.data.requiredDate.size() >= 10 &&
        request.resource.data.priority in ["Low", "Normal", "High", "Urgent"] &&
        request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 25 &&
        request.resource.data.status in ["draft", "pending approval", "approved", "rejected", "converted to po"] &&
        request.resource.data.createdBy is string && request.resource.data.createdBy.size() > 0 &&
        (!request.resource.data.keys().hasAll(["rejectionReason"]) ||
          (request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.size() <= 500));
    }

    function hasValidPurchaseRequestTransition() {
      return request.resource.data.status == resource.data.status ||
        (resource.data.status == "pending approval" &&
          request.resource.data.status == "approved" &&
          request.resource.data.approvedBy == request.auth.uid &&
          request.resource.data.approvedAt == request.time) ||
        (resource.data.status == "pending approval" &&
          request.resource.data.status == "rejected" &&
          request.resource.data.approvedBy == request.auth.uid &&
          request.resource.data.approvedAt == request.time &&
          request.resource.data.rejectionReason is string &&
          request.resource.data.rejectionReason.size() > 0) ||
        (resource.data.status == "approved" && request.resource.data.status == "converted to po");
    }

    function hasValidPurchaseOrderData(orderId) {
      return request.resource.data.keys().hasAll([
          "poNumber", "vendorId", "vendorName", "site", "poDate", "expectedDeliveryDate",
          "items", "subtotal", "discount", "tax", "grandTotal", "paidAmount", "outstandingAmount",
          "status", "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "poNumber", "purchaseRequestId", "vendorId", "vendorName", "site", "siteId", "poDate",
          "expectedDeliveryDate", "items", "paymentTerms", "deliveryTerms", "notes", "subtotal",
          "discount", "tax", "grandTotal", "paidAmount", "outstandingAmount", "status", "createdBy",
          "lastGoodsReceiptId", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.poNumber == orderId &&
        request.resource.data.vendorId is string && request.resource.data.vendorId.size() > 0 &&
        request.resource.data.vendorName is string && request.resource.data.vendorName.size() > 0 &&
        request.resource.data.site is string && request.resource.data.site.size() > 0 &&
        request.resource.data.poDate is string && request.resource.data.poDate.size() >= 10 &&
        request.resource.data.expectedDeliveryDate is string && request.resource.data.expectedDeliveryDate.size() >= 10 &&
        request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 25 &&
        request.resource.data.subtotal is number && request.resource.data.subtotal >= 0 &&
        request.resource.data.discount is number && request.resource.data.discount >= 0 &&
        request.resource.data.tax is number && request.resource.data.tax >= 0 &&
        request.resource.data.grandTotal is number && request.resource.data.grandTotal >= 0 &&
        request.resource.data.paidAmount is number && request.resource.data.paidAmount >= 0 && request.resource.data.paidAmount <= request.resource.data.grandTotal &&
        request.resource.data.outstandingAmount is number && request.resource.data.outstandingAmount >= 0 &&
        request.resource.data.status in ["draft", "issued", "partially received", "received", "cancelled"] &&
        request.resource.data.createdBy is string && request.resource.data.createdBy.size() > 0 &&
        (!request.resource.data.keys().hasAll(["lastGoodsReceiptId"]) ||
          (request.resource.data.lastGoodsReceiptId is string && request.resource.data.lastGoodsReceiptId.size() > 0 && request.resource.data.lastGoodsReceiptId.size() <= 200));
    }

    function samePurchaseOrderReceiptLink() {
      return (!resource.data.keys().hasAll(["lastGoodsReceiptId"]) &&
          !request.resource.data.keys().hasAll(["lastGoodsReceiptId"])) ||
        (resource.data.keys().hasAll(["lastGoodsReceiptId"]) &&
          request.resource.data.keys().hasAll(["lastGoodsReceiptId"]) &&
          request.resource.data.lastGoodsReceiptId == resource.data.lastGoodsReceiptId);
    }

    function isPurchaseOrderReceiptUpdate(orderId) {
      let receiptPath = /databases/$(database)/documents/goodsReceipts/$(request.resource.data.lastGoodsReceiptId);
      let receipt = getAfter(receiptPath).data;

      return request.resource.data.keys().hasAll(["lastGoodsReceiptId"]) &&
        request.resource.data.lastGoodsReceiptId is string && request.resource.data.lastGoodsReceiptId.size() > 0 &&
        (!resource.data.keys().hasAll(["lastGoodsReceiptId"]) ||
          request.resource.data.lastGoodsReceiptId != resource.data.lastGoodsReceiptId) &&
        !exists(receiptPath) && existsAfter(receiptPath) &&
        receipt.purchaseOrderId == orderId && receipt.status == "completed";
    }

    function hasValidPurchaseOrderTransition() {
      return (resource.data.status == "draft" && request.resource.data.status == "draft") ||
        (resource.data.status == "draft" && request.resource.data.status in ["issued", "cancelled"] &&
          request.resource.data.items == resource.data.items && samePurchaseOrderReceiptLink() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])) ||
        (request.resource.data.status == resource.data.status && resource.data.status in ["issued", "partially received", "received"] &&
          request.resource.data.items == resource.data.items && samePurchaseOrderReceiptLink() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paidAmount", "outstandingAmount", "updatedAt"])) ||
        (resource.data.status in ["issued", "partially received"] &&
          request.resource.data.status in ["partially received", "received"] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["items", "status", "lastGoodsReceiptId", "updatedAt"]) &&
          isPurchaseOrderReceiptUpdate(request.resource.data.poNumber));
    }

    function hasValidGoodsReceiptData(receiptId) {
      return request.resource.data.keys().hasAll([
          "grnNumber", "status", "purchaseOrderId", "poNumber", "vendorId", "vendorName", "site",
          "receiptKey",
          "lineId", "materialName", "unit", "orderedQuantity", "previousReceivedQuantity",
          "receivedQuantity", "acceptedQuantity", "rejectedQuantity", "receiptDate",
          "inventoryTransactionId", "materialEntryId", "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.keys().hasOnly([
          "receiptKey", "grnNumber", "status", "purchaseOrderId", "poNumber", "vendorId", "vendorName", "site", "siteId",
          "lineId", "materialId", "materialName", "unit", "orderedQuantity", "previousReceivedQuantity",
          "receivedQuantity", "acceptedQuantity", "rejectedQuantity", "challanNumber", "vehicleNumber",
          "receivedBy", "receiptDate", "remarks", "inventoryTransactionId", "materialEntryId",
          "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.receiptKey == receiptId && request.resource.data.grnNumber is string && request.resource.data.grnNumber.size() > 0 && request.resource.data.status == "completed" &&
        request.resource.data.purchaseOrderId is string && request.resource.data.purchaseOrderId.size() > 0 &&
        request.resource.data.vendorId is string && request.resource.data.vendorId.size() > 0 &&
        request.resource.data.site is string && request.resource.data.site.size() > 0 &&
        request.resource.data.lineId is string && request.resource.data.lineId.size() > 0 &&
        request.resource.data.materialName is string && request.resource.data.materialName.size() > 0 &&
        request.resource.data.unit is string && request.resource.data.unit.size() > 0 &&
        request.resource.data.orderedQuantity is number && request.resource.data.orderedQuantity > 0 &&
        request.resource.data.previousReceivedQuantity is number && request.resource.data.previousReceivedQuantity >= 0 &&
        request.resource.data.receivedQuantity is number && request.resource.data.receivedQuantity > 0 &&
        request.resource.data.acceptedQuantity is number && request.resource.data.acceptedQuantity >= 0 &&
        request.resource.data.rejectedQuantity is number && request.resource.data.rejectedQuantity >= 0 &&
        request.resource.data.acceptedQuantity + request.resource.data.rejectedQuantity == request.resource.data.receivedQuantity &&
        request.resource.data.previousReceivedQuantity + request.resource.data.receivedQuantity <= request.resource.data.orderedQuantity &&
        request.resource.data.receiptDate is string && request.resource.data.receiptDate.size() >= 10 &&
        request.resource.data.inventoryTransactionId is string && request.resource.data.materialEntryId is string &&
        ((request.resource.data.acceptedQuantity == 0 &&
            request.resource.data.inventoryTransactionId == "" && request.resource.data.materialEntryId == "") ||
          (request.resource.data.acceptedQuantity > 0 &&
            request.resource.data.inventoryTransactionId.size() > 0 && request.resource.data.materialEntryId.size() > 0)) &&
        request.resource.data.createdBy == request.auth.uid;
    }

    function hasLinkedGoodsReceiptRecords(receiptId) {
      let movementPath = /databases/$(database)/documents/inventoryTransactions/$(request.resource.data.inventoryTransactionId);
      let materialPath = /databases/$(database)/documents/materials/$(request.resource.data.materialEntryId);
      let orderPath = /databases/$(database)/documents/purchaseOrders/$(request.resource.data.purchaseOrderId);
      let movement = getAfter(movementPath).data;
      let material = getAfter(materialPath).data;
      let order = getAfter(orderPath).data;

      return existsAfter(movementPath) && existsAfter(materialPath) && existsAfter(orderPath) &&
          order.lastGoodsReceiptId == receiptId &&
          movement.goodsReceiptId == receiptId && movement.purchaseOrderId == request.resource.data.purchaseOrderId &&
          movement.vendorId == request.resource.data.vendorId && movement.quantity == request.resource.data.acceptedQuantity &&
          material.goodsReceiptId == receiptId && material.purchaseOrderId == request.resource.data.purchaseOrderId &&
          material.inventoryTransactionId == request.resource.data.inventoryTransactionId;
    }

    function isGoodsReceiptLinkedToPurchaseOrder(receiptId) {
      let orderPath = /databases/$(database)/documents/purchaseOrders/$(request.resource.data.purchaseOrderId);
      let order = getAfter(orderPath).data;
      return exists(orderPath) && existsAfter(orderPath) &&
        order.lastGoodsReceiptId == receiptId;
    }

    function isLinkedProcurementMaterial(materialId) {
      let receiptPath = /databases/$(database)/documents/goodsReceipts/$(request.resource.data.goodsReceiptId);
      let receipt = getAfter(receiptPath).data;

      return request.resource.data.keys().hasAll([
          "goodsReceiptId", "purchaseOrderId", "vendorId", "inventoryTransactionId"
        ]) &&
        existsAfter(receiptPath) &&
        receipt.materialEntryId == materialId &&
        receipt.receiptKey == request.resource.data.goodsReceiptId &&
        receipt.purchaseOrderId == request.resource.data.purchaseOrderId &&
        receipt.vendorId == request.resource.data.vendorId &&
        receipt.inventoryTransactionId == request.resource.data.inventoryTransactionId;
    }

    function sameInventoryLastTransactionId() {
      return (!resource.data.keys().hasAll(["lastTransactionId"]) &&
          !request.resource.data.keys().hasAll(["lastTransactionId"])) ||
        (resource.data.keys().hasAll(["lastTransactionId"]) &&
          request.resource.data.keys().hasAll(["lastTransactionId"]) &&
          request.resource.data.lastTransactionId == resource.data.lastTransactionId);
    }

    function isInventoryTransactionApplied(transactionId) {
      let itemPath = /databases/$(database)/documents/inventoryItems/$(request.resource.data.inventoryItemId);
      let beforeItem = get(itemPath).data;
      let afterItem = getAfter(itemPath).data;
      let quantity = request.resource.data.quantity;

      return exists(itemPath) &&
        existsAfter(itemPath) &&
        afterItem.lastTransactionId == transactionId &&
        afterItem.materialName == request.resource.data.materialName &&
        afterItem.site == request.resource.data.site &&
        afterItem.unit == request.resource.data.unit &&
        ((request.resource.data.transactionType == "in" &&
            afterItem.currentStock == beforeItem.currentStock + quantity) ||
          (request.resource.data.transactionType == "out" &&
            afterItem.currentStock == beforeItem.currentStock - quantity) ||
          (request.resource.data.transactionType == "adjustment" &&
            request.resource.data.adjustmentDirection == "increase" &&
            afterItem.currentStock == beforeItem.currentStock + quantity) ||
          (request.resource.data.transactionType == "adjustment" &&
            request.resource.data.adjustmentDirection == "decrease" &&
            afterItem.currentStock == beforeItem.currentStock - quantity));
    }

    function isInventoryItemMovementUpdate(itemId) {
      let transactionPath = /databases/$(database)/documents/inventoryTransactions/$(request.resource.data.lastTransactionId);
      let movement = getAfter(transactionPath).data;
      let quantity = movement.quantity;

      return request.resource.data.keys().hasAll(["lastTransactionId"]) &&
        request.resource.data.lastTransactionId is string &&
        request.resource.data.lastTransactionId.size() > 0 &&
        (!resource.data.keys().hasAll(["lastTransactionId"]) ||
          request.resource.data.lastTransactionId != resource.data.lastTransactionId) &&
        !exists(transactionPath) &&
        existsAfter(transactionPath) &&
        movement.inventoryItemId == itemId &&
        movement.createdBy == request.auth.uid &&
        movement.materialName == resource.data.materialName &&
        movement.site == resource.data.site &&
        movement.unit == resource.data.unit &&
        ((movement.transactionType == "in" &&
            request.resource.data.currentStock == resource.data.currentStock + quantity) ||
          (movement.transactionType == "out" &&
            request.resource.data.currentStock == resource.data.currentStock - quantity) ||
          (movement.transactionType == "adjustment" &&
            movement.adjustmentDirection == "increase" &&
            request.resource.data.currentStock == resource.data.currentStock + quantity) ||
          (movement.transactionType == "adjustment" &&
            movement.adjustmentDirection == "decrease" &&
            request.resource.data.currentStock == resource.data.currentStock - quantity));
    }

    // Users may read only their own authorization profile. Roles can only be
    // assigned or changed from the Firebase Console/Admin SDK, never by a client.
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /sites/{document=**} {
      allow read: if isAuthorizedErpUser() || isFieldUser();
      allow create, update, delete: if canWriteErpData();
    }

    // Budget documents are separated from site reference records so field
    // users can select a site for DPR entry without receiving finance data.
    match /siteBudgets/{siteId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidSiteBudgetData(siteId) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidSiteBudgetData(siteId) &&
        request.resource.data.siteId == resource.data.siteId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Quantity-only availability documents are safe for field users to read.
    // Supplier references and stock data intentionally exclude rates/costs.
    match /inventoryItems/{itemId} {
      allow read: if isAuthorizedErpUser() || isFieldUser();
      allow create: if canWriteErpData() && hasValidInventoryItemData(itemId) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidInventoryItemData(itemId) &&
        request.resource.data.itemKey == resource.data.itemKey &&
        request.resource.data.materialName == resource.data.materialName &&
        request.resource.data.site == resource.data.site &&
        request.resource.data.unit == resource.data.unit &&
        request.resource.data.openingStock == resource.data.openingStock &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        ((request.resource.data.currentStock == resource.data.currentStock &&
            sameInventoryLastTransactionId()) ||
          isInventoryItemMovementUpdate(itemId));
      allow delete: if false;
    }

    // Stock movements are append-only. The inventory item stores a safe
    // current-stock snapshot for field availability, while this ledger remains
    // available only to core ERP roles.
    match /inventoryTransactions/{transactionId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidInventoryTransactionData() &&
        request.resource.data.createdAt == request.time &&
        isInventoryTransactionApplied(transactionId) &&
        (!request.resource.data.keys().hasAll(["sourceType"]) ||
          request.resource.data.sourceType != "goodsReceipt" ||
          isLinkedGoodsReceiptMovement(transactionId));
      allow update, delete: if false;
    }

    // Procurement master data is append-preserved: vendors can be disabled,
    // but not deleted once they may be referenced by purchasing history.
    match /vendors/{vendorId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidVendorData() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidVendorData() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /purchaseRequests/{requestId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidPurchaseRequestData(requestId) &&
        request.resource.data.status == "pending approval" &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidPurchaseRequestData(requestId) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time &&
        hasValidPurchaseRequestTransition();
      allow delete: if false;
    }

    match /purchaseOrders/{orderId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidPurchaseOrderData(orderId) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() && hasValidPurchaseOrderData(orderId) &&
        request.resource.data.poNumber == resource.data.poNumber &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time &&
        hasValidPurchaseOrderTransition();
      allow delete: if false;
    }

    // GRNs are completed once. Any accepted quantity is linked atomically to
    // one immutable inventory Stock-In movement and one materials cost record.
    match /goodsReceipts/{receiptId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() && hasValidGoodsReceiptData(receiptId) &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time &&
        isGoodsReceiptLinkedToPurchaseOrder(receiptId) &&
        (request.resource.data.acceptedQuantity == 0 || hasLinkedGoodsReceiptRecords(receiptId));
      allow update, delete: if false;
    }

    match /labours/{document=**} {
      allow read: if isAuthorizedErpUser();
      allow create, update, delete: if canWriteErpData();
    }

    match /materials/{materialId} {
      // Material purchases can contain rates and amounts. Field users receive
      // names/availability through inventoryItems instead of this collection.
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() &&
        (!request.resource.data.keys().hasAll(["source"]) ||
          request.resource.data.source != "procurement" ||
          isLinkedProcurementMaterial(materialId));
      // Procurement GRN cost entries are immutable links to the accepted
      // receipt. They remain the single financial source for that purchase.
      allow update, delete: if canWriteErpData() &&
        (!resource.data.keys().hasAll(["source"]) || resource.data.source != "procurement");
    }

    match /expenses/{document=**} {
      allow read: if isAuthorizedErpUser();
      allow create, update, delete: if canWriteErpData();
    }

    match /attendance/{document=**} {
      allow read: if isAuthorizedErpUser();
      allow create, update, delete: if canWriteErpData();
    }

    match /salaries/{document=**} {
      allow read: if isAuthorizedErpUser();
      allow create, update, delete: if canWriteErpData();
    }

    function isLinkedSalaryPayment() {
      let salaryPath = /databases/$(database)/documents/salaries/$(request.resource.data.salaryId);
      let beforeSalary = get(salaryPath).data;
      let afterSalary = getAfter(salaryPath).data;
      return exists(salaryPath) &&
        beforeSalary.pendingAmount is number && beforeSalary.paidAmount is number &&
        request.resource.data.amount <= beforeSalary.pendingAmount &&
        afterSalary.paidAmount == beforeSalary.paidAmount + request.resource.data.amount &&
        afterSalary.pendingAmount == beforeSalary.pendingAmount - request.resource.data.amount;
    }

    // Payroll payments are an immutable settlement ledger. They do not add a
    // second financial expense: the linked salary's net amount is canonical.
    match /salaryPayments/{paymentId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() &&
        request.resource.data.keys().hasAll([
          "salaryId", "labourId", "labourName", "payrollMonth", "site",
          "amount", "paymentDate", "paymentMode", "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.salaryId is string && request.resource.data.salaryId.size() > 0 &&
        request.resource.data.labourId is string && request.resource.data.labourId.size() > 0 &&
        request.resource.data.labourName is string && request.resource.data.labourName.size() > 0 &&
        request.resource.data.payrollMonth is string && request.resource.data.payrollMonth.size() == 7 &&
        request.resource.data.site is string && request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.paymentDate is string && request.resource.data.paymentDate.size() > 0 &&
        request.resource.data.paymentMode is string && request.resource.data.paymentMode.size() > 0 &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time &&
        isLinkedSalaryPayment();
      allow update, delete: if false;
    }

    // Advances retain their original issue record. Only manager/admin recovery
    // state may change; field roles receive no read access to payroll data.
    match /labourAdvances/{advanceId} {
      allow read: if isAuthorizedErpUser();
      allow create: if canWriteErpData() &&
        request.resource.data.keys().hasAll([
          "labourId", "labourName", "site", "date", "amount", "recoveredAmount",
          "recoveryStatus", "createdBy", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.labourId is string && request.resource.data.labourId.size() > 0 &&
        request.resource.data.labourName is string && request.resource.data.labourName.size() > 0 &&
        request.resource.data.site is string && request.resource.data.date is string && request.resource.data.date.size() > 0 &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.recoveredAmount is number && request.resource.data.recoveredAmount >= 0 &&
        request.resource.data.recoveredAmount <= request.resource.data.amount &&
        request.resource.data.recoveryStatus in ["Pending", "Partial", "Recovered"] &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if canWriteErpData() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.labourId == resource.data.labourId &&
        request.resource.data.recoveredAmount is number && request.resource.data.recoveredAmount >= resource.data.recoveredAmount &&
        request.resource.data.recoveredAmount <= resource.data.amount &&
        request.resource.data.recoveryStatus in ["Pending", "Partial", "Recovered"] &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /vehicles/{document=**} {
      allow read: if isAuthorizedErpUser() || isFieldUser();
      allow create, update, delete: if canWriteErpData();
    }

    match /vehicleExpenses/{document=**} {
      allow read: if isAuthorizedErpUser();
      allow create, update, delete: if canWriteErpData();
    }

    match /dailyProgressReports/{document=**} {
      allow read: if canReadDailyProgressReport();
      allow create: if canWriteErpData() || canCreateFieldDailyProgressReport();
      allow update, delete: if canWriteErpData();
    }

    // Audit entries are immutable. The client can append an identity-validated
    // entry after a successful action, but only an active administrator can read it.
    match /auditLogs/{documentId} {
      allow read: if isAdmin();
      allow create: if canCreateAuditLog();
      allow update, delete: if false;
    }

    match /invoices/{document=**} {
      allow read: if isAuthorizedErpUser();
      allow create, update, delete: if canWriteErpData();
    }

    // Any current or future collection not explicitly listed is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
