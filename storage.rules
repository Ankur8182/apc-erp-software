rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasActiveRole(roles) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    function isAdminOrManager() {
      return hasActiveRole(["admin", "manager"]);
    }

    function isFieldUser() {
      return hasActiveRole(["supervisor", "engineer"]);
    }

    function isCoreErpReader() {
      return hasActiveRole(["admin", "manager", "viewer"]);
    }

    function canReadDprPhoto(userId) {
      return isCoreErpReader() ||
        (isFieldUser() && request.auth.uid == userId);
    }

    function isValidDprImage() {
      return request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /dpr/{userId}/{dprId}/{fileName} {
      // Keep field-photo reads aligned with DPR document ownership.
      allow read: if canReadDprPhoto(userId);
      allow create: if isValidDprImage() &&
        (isAdminOrManager() || (isFieldUser() && request.auth.uid == userId));
      allow delete: if isAdminOrManager() ||
        (isFieldUser() && request.auth.uid == userId);
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
